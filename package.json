{
  "name": "shape-toolbox",
  "version": "0.0.0",
  "description": "Typed async composition, nested data access, and immutable updates with no runtime dependencies and no any.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Andre Newman",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js"
    },
    "./path": {
      "types": "./dist/path.d.ts",
      "import": "./dist/path.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "docs": "typedoc",
    "docs:check": "node scripts/check-docs.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:package": "publint && attw --pack --profile esm-only",
    "check:size": "size-limit",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run coverage && npm run check:no-any && npm run docs:check && npm run docs && npm run check:imports && npm run check:package && npm run check:size && npm run check:capabilities && npm run check:consumer",
    "prepack": "npm run build",
    "changeset": "changeset",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "typecheck:matrix": "npm run typecheck && npx -y -p typescript@5.9.3 tsc -p tsconfig.json && npx -y -p typescript@7.0.2 tsc -p tsconfig.json",
    "check:no-any": "node scripts/check-no-any.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.10",
    "@vitest/browser": "5.1.2",
    "@vitest/browser-playwright": "5.1.2",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.5.5",
    "fast-check": "4.11.0",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
