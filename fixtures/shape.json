{
  "description": "Nested objects, arrays, and empty containers preserve their shape.",
  "operation": "applySpecAsync",
  "args": [
    {
      "id": 7
    }
  ],
  "mode": "all",
  "spec": {
    "profile": {
      "$task": "profile"
    },
    "nested": {
      "orders": {
        "$task": "orders"
      }
    },
    "labels": [
      {
        "$task": "label"
      }
    ],
    "empty": {},
    "emptyList": []
  },
  "tasks": {
    "profile": {
      "resolve": {
        "id": 7,
        "name": "Andre"
      }
    },
    "orders": {
      "resolve": [
        {
          "ownerId": 7,
          "total": 42
        }
      ]
    },
    "label": {
      "resolve": "user-7"
    }
  },
  "expected": {
    "profile": {
      "id": 7,
      "name": "Andre"
    },
    "nested": {
      "orders": [
        {
          "ownerId": 7,
          "total": 42
        }
      ]
    },
    "labels": [
      "user-7"
    ],
    "empty": {},
    "emptyList": []
  }
}
